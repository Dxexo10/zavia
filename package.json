{
  "name": "zavia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "test:mutation-control": "node scripts/manual-mutation-control.mjs",
    "test:e2e": "playwright test",
    "check:traceability": "node --experimental-strip-types scripts/check-traceability.ts",
    "detect:design": "node scripts/detect-design.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:layers": "depcruise --config .dependency-cruiser.cjs src",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": [
      "prettier --write"
    ],
    "{src,tests}/**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
